{
  "name": "who-is-ev-top-databot",
  "version": "1.0.0",
  "private": true,
  "description": "EV販売データの半自動更新パイプライン。サイト本体(ビルド不要のHTML/JS)とは独立。",
  "type": "module",
  "scripts": {
    "fetch:update": "cd .. && tsx scripts/update-data.ts",
    "validate": "cd .. && tsx scripts/validate.ts --html index.html",
    "typecheck": "tsc --noEmit",
    "test": "tsx test/run-tests.ts",
    "test:parser": "tsx test/parser-test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "jsdom": "^30.0.1",
    "xlsx": "^0.18.5"
  }
}